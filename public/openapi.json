{"openapi":"3.1.0","info":{"title":"OwnPay Canonical API","version":"1.0.0","description":"Universal Payment Rails & Control Plane for Humans and Autonomous AI Agents on Base L2.\n\n**Settlement Rail:** Non-Custodial Base Mainnet (`8453`) & Base Sepolia (`84532`).\n\nFor commercial policies, developer guides, and pricing details, visit https://ownpay.tech/pricing and https://ownpaylab.dev.","contact":{"name":"OwnPay Developer Platform","url":"https://ownpaylab.dev"}},"servers":[{"url":"https://ownpaylab.dev/api/v1","description":"OwnPay Developer API"}],"components":{"securitySchemes":{"ApiKeyAuth":{"type":"http","scheme":"bearer","bearerFormat":"own_live_* / own_test_*","description":"Authenticate using an OwnPay API key: `Bearer own_live_...` or `Bearer own_test_...`"}},"schemas":{"ApiResponse":{"type":"object","properties":{"success":{"type":"boolean","example":true},"error":{"type":"string","example":"Resource not found"},"code":{"type":"string","example":"RESOURCE_NOT_FOUND"},"data":{"type":"object"}},"required":["success"]},"PaymentIntent":{"type":"object","properties":{"intent_id":{"type":"string","format":"uuid","example":"9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"},"order_id":{"type":"string","example":"ORD-982173"},"payment_address":{"type":"string","example":"0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"},"usdc_amount":{"type":"number","example":25},"fiat_amount":{"type":"number","example":25},"fiat_currency":{"type":"string","example":"USD"},"exchange_rate":{"type":"number","example":1},"qr_data":{"type":"string","example":"ethereum:0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913@8453/transfer?address=0x...&uint256=25000000"},"status":{"type":"string","enum":["PENDING","CONFIRMED","EXPIRED"],"example":"PENDING"},"network":{"type":"string","example":"base"},"chain_id":{"type":"integer","example":8453},"expires_at":{"type":"string","format":"date-time","example":"2026-09-16T15:30:00.000Z"}}},"PaymentExecution":{"type":"object","properties":{"payment_id":{"type":"strin